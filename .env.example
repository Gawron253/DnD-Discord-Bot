# Discord Bot Credentials
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_GUILD_ID="your_guild_id_here"

# AI Provider Keys (choose one or more)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# AI Model Configuration (Google Gemini 3.7 Flash - Hybrid Reasoning Model)
DEFAULT_AI_MODEL="gemini-3.7-flash"
AI_PROVIDER="gemini"
GEMINI_TEMPERATURE=0.70

# Gemini 3.7 Flash Thinking Configuration:
# 0 = Thinking disabled (ultra-fast low-latency narration, 0 thinking token cost)
# -1 = Automatic / Dynamic reasoning (model decides thinking depth based on RPG scene complexity)
# >0 = Fixed thinking token budget (e.g. 1024, 2048, 4096 for deep tactical rules / multi-NPC reasoning)
GEMINI_THINKING_BUDGET=0
GEMINI_INCLUDE_THOUGHTS=false

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///data/dnd_campaign.db"
CHROMA_PERSIST_DIR="data/chroma_db"

# Game Settings
AUTO_SYNC_CHANNELS=true
ENABLE_SCENE_IMAGES=false
