# ==============================================================================
# DISCORD & AI DUNGEON MASTER CONFIGURATION (.env)
# ==============================================================================

# 1. Discord Bot Credentials (wymagane)
# Token bota wygenerowany w https://discord.com/developers/applications
DISCORD_BOT_TOKEN="TWOJ_TOKEN_BOTA_DISCORD"

# Opcjonalne ID Twojego serwera Discord (do szybkiej rejestracji komend slash)
DISCORD_GUILD_ID=""

# 2. Google Gemini API (wymagane do narracji AI)
# Klucz API wygenerowany w https://aistudio.google.com/
GEMINI_API_KEY="TWOJ_KLUCZ_GOOGLE_GEMINI_API"

# 3. Model i Parametry Gemini 3.7 Flash (Hybrid Reasoning)
DEFAULT_AI_MODEL="gemini-3.7-flash"
GEMINI_TEMPERATURE=0.70

# Budżet myślenia (ThinkingConfig):
# 0 = wyłączone myślenie (błyskawiczna narracja, 0 dodatkowych tokenów myślenia)
# -1 = automatyczne dynamiczne myślenie (model sam decyduje w zależności od złożoności sceny)
# >0 = stały budżet tokenów (np. 1024, 2048 dla złożonych zagadek i taktycznych starć)
GEMINI_THINKING_BUDGET=0
GEMINI_INCLUDE_THOUGHTS=false
